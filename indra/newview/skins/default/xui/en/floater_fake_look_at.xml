<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="850"
 min_height="760"
 min_width="500"
 width="560"
 layout="topleft"
 name="fake_look_at"
 title="Fake Look At Lab">

  <text
   name="intro"
   layout="topleft"
   left="16"
   right="-16"
   top="16"
   height="52"
   follows="left|top|right"
   word_wrap="true">
    Generate additional ViewerEffect LookAt targets independently of the normal camera LookAt. For local crosses and custom labels, enable Developer &gt; Avatar &gt; Show Look At.
  </text>

  <text name="mode_label" layout="topleft" left="16" top="82" width="105" height="18">
    Target mode:
  </text>
  <combo_box
   name="mode"
   layout="topleft"
   left="128"
   top="76"
   width="250"
   height="26"
   allow_text_entry="false">
    <combo_box.item label="Random positions" name="RandomPositions" value="random_positions" />
    <combo_box.item label="Look at all avatars" name="AllAvatars" value="all_avatars" />
    <combo_box.item label="Random avatars" name="RandomAvatars" value="random_avatars" />
    <combo_box.item label="Random world objects" name="RandomObjects" value="random_objects" />
    <combo_box.item label="Mixed avatars / objects / positions" name="Mixed" value="mixed" />
  </combo_box>

  <text name="look_type_label" layout="topleft" left="16" top="118" width="105" height="18">
    Look-at type:
  </text>
  <combo_box
   name="look_type"
   layout="topleft"
   left="128"
   top="112"
   width="210"
   height="26"
   allow_text_entry="false">
    <combo_box.item label="Focus" name="Focus" value="8" />
    <combo_box.item label="Select" name="Select" value="7" />
    <combo_box.item label="Mouselook" name="Mouselook" value="9" />
    <combo_box.item label="Conversation" name="Conversation" value="6" />
    <combo_box.item label="Hover" name="Hover" value="5" />
    <combo_box.item label="Respond" name="Respond" value="4" />
    <combo_box.item label="Free look" name="FreeLook" value="3" />
    <combo_box.item label="Auto listen" name="AutoListen" value="2" />
    <combo_box.item label="Idle" name="Idle" value="1" />
  </combo_box>

  <text
   name="labels_header"
   layout="topleft"
   left="16"
   top="153"
   width="310"
   height="18"
   font="SansSerifSmall"
   font.style="BOLD">
    Local debug cross labels
  </text>

  <text name="label_mode_label" layout="topleft" left="16" top="183" width="105" height="18">
    Label mode:
  </text>
  <combo_box
   name="label_mode"
   layout="topleft"
   left="128"
   top="177"
   width="250"
   height="26"
   allow_text_entry="false"
   tool_tip="Custom labels are local to this viewer and are not transmitted as avatar names.">
    <combo_box.item label="Actual target avatar name" name="Actual" value="actual" />
    <combo_box.item label="Single custom name" name="Single" value="single" />
    <combo_box.item label="Random name from list" name="RandomList" value="random_list" />
    <combo_box.item label="Sequential names from list" name="SequentialList" value="sequential_list" />
  </combo_box>

  <text name="single_label_label" layout="topleft" left="16" top="219" width="105" height="18">
    Single name:
  </text>
  <line_editor
   name="single_label"
   layout="topleft"
   left="128"
   right="-16"
   top="213"
   height="26"
   follows="left|top|right"
   max_length_bytes="255"
   tool_tip="Used when Label mode is Single custom name." />

  <text name="label_list_label" layout="topleft" left="16" top="255" width="105" height="18">
    Name list:
  </text>
  <line_editor
   name="label_list"
   layout="topleft"
   left="128"
   right="-16"
   top="249"
   height="26"
   follows="left|top|right"
   max_length_bytes="4096"
   tool_tip="Comma or semicolon separated names." />

  <text name="count_label" layout="topleft" left="16" top="291" width="105" height="18">
    Effect count:
  </text>
  <spinner
   name="count"
   layout="topleft"
   left="128"
   top="284"
   width="92"
   height="26"
   min_val="0"
   max_val="64"
   increment="1"
   decimal_digits="0"
   value="8"
   tool_tip="0 means all matching avatars only in Look at all avatars mode." />
  <check_box
   name="randomize_count"
   label="Randomize 1..count each refresh"
   layout="topleft"
   left="238"
   top="289"
   width="250"
   height="20" />

  <text
   name="distance_header"
   layout="topleft"
   left="16"
   top="330"
   width="260"
   height="18"
   font="SansSerifSmall"
   font.style="BOLD">
    Distance filter / random radius
  </text>

  <text name="min_distance_label" layout="topleft" left="16" top="360" width="105" height="18">
    Minimum:
  </text>
  <spinner
   name="min_distance"
   layout="topleft"
   left="128"
   top="353"
   width="92"
   height="26"
   min_val="0"
   max_val="4096"
   increment="0.5"
   decimal_digits="1"
   value="2" />

  <text name="max_distance_label" layout="topleft" left="250" top="360" width="90" height="18">
    Maximum:
  </text>
  <spinner
   name="max_distance"
   layout="topleft"
   left="342"
   top="353"
   width="100"
   height="26"
   min_val="0"
   max_val="4096"
   increment="1"
   decimal_digits="1"
   value="25" />

  <text
   name="timing_header"
   layout="topleft"
   left="16"
   top="399"
   width="240"
   height="18"
   font="SansSerifSmall"
   font.style="BOLD">
    Motion and refresh
  </text>

  <text name="refresh_label" layout="topleft" left="16" top="429" width="105" height="18">
    Refresh every:
  </text>
  <spinner
   name="refresh_seconds"
   layout="topleft"
   left="128"
   top="422"
   width="92"
   height="26"
   min_val="0.5"
   max_val="120"
   increment="0.5"
   decimal_digits="1"
   value="3"
   tool_tip="Minimum is 0.5 seconds to avoid excessive ViewerEffect traffic." />
  <text name="refresh_units" layout="topleft" left="226" top="429" width="65" height="18">seconds</text>

  <text name="vertical_label" layout="topleft" left="16" top="465" width="105" height="18">
    Vertical spread:
  </text>
  <spinner
   name="vertical_scale"
   layout="topleft"
   left="128"
   top="458"
   width="92"
   height="26"
   min_val="0"
   max_val="1"
   increment="0.05"
   decimal_digits="2"
   value="0.35" />

  <text name="jitter_label" layout="topleft" left="250" top="465" width="90" height="18">
    Object jitter:
  </text>
  <spinner
   name="object_jitter"
   layout="topleft"
   left="342"
   top="458"
   width="100"
   height="26"
   min_val="0"
   max_val="64"
   increment="0.05"
   decimal_digits="2"
   value="0.25" />

  <text
   name="filters_header"
   layout="topleft"
   left="16"
   top="505"
   width="240"
   height="18"
   font="SansSerifSmall"
   font.style="BOLD">
    Object filters
  </text>

  <check_box
   name="current_region_only"
   label="Only targets in my current region"
   layout="topleft"
   left="16"
   top="533"
   width="275"
   height="20"
   value="true" />
  <check_box
   name="root_objects_only"
   label="World objects: root prims only"
   layout="topleft"
   left="16"
   top="561"
   width="275"
   height="20"
   value="true" />
  <check_box
   name="exclude_attachments"
   label="World objects: exclude attachments"
   layout="topleft"
   left="300"
   top="533"
   width="240"
   height="20"
   value="true" />
  <check_box
   name="stop_on_close"
   label="Stop when this window closes"
   layout="topleft"
   left="300"
   top="561"
   width="240"
   height="20"
   value="false" />

  <text
   name="transmit_header"
   layout="topleft"
   left="16"
   top="599"
   width="300"
   height="18"
   font="SansSerifSmall"
   font.style="BOLD">
    Fake-effect transmission
  </text>

  <check_box
   name="bypass_distance_limit"
   label="Use Lab distances instead of the viewer's normal LookAt distance limit"
   layout="topleft"
   left="16"
   top="627"
   width="520"
   height="20"
   value="true"
   tool_tip="Applies only to Fake Look At Lab effects. Normal camera LookAt behavior is unchanged." />

  <text
   name="limits_note"
   layout="topleft"
   left="16"
   right="-16"
   top="658"
   height="42"
   follows="left|top|right"
   word_wrap="true">
    Hard limit: 64 simultaneous fake LookAt effects. Custom labels are local-only; ViewerEffect targets themselves are sent through the normal viewer effect path.
  </text>

  <button
   name="start"
   label="Start"
   layout="topleft"
   left="16"
   top="712"
   width="130"
   height="32" />
  <button
   name="refresh_now"
   label="Refresh Targets Now"
   layout="topleft"
   left="158"
   top="712"
   width="180"
   height="32" />
  <button
   name="stop"
   label="STOP / CLEAR"
   layout="topleft"
   left="350"
   top="712"
   width="160"
   height="32" />

  <text
   name="status_header"
   layout="topleft"
   left="16"
   top="760"
   width="120"
   height="18"
   font="SansSerifSmall"
   font.style="BOLD">
    Status
  </text>
  <text
   name="status"
   layout="topleft"
   left="16"
   right="-16"
   top="783"
   bottom="-12"
   follows="left|top|right|bottom"
   word_wrap="true">
    Stopped
  </text>
</floater>
